# Never commit game files - users supply their own
*.gb
*.gbc
*.gba
*.sgb
*.zip
*.7z

# Saves and save states
*.sav
*.srm
*.ss[0-9]
*.ss

# Extracted / exported game graphics (copyrighted - generate locally from your own ROM)
sprites/
*.2bpp
*.pic

# Captured game state (contains your trainer name/ID). Keep the folder, not the files.
fixtures/*
!fixtures/README.md

# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Local Claude Code notes
CLAUDE.md
